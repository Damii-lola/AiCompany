# Copy these into Render -> this worker service -> Environment.

# Same Supabase project as render-service, same secret key — this worker
# is Render-side infra too, so it holding a Supabase key doesn't break the
# "only Render holds Supabase credentials" rule (Kaggle never gets one).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=the-secret-key-from-supabase-api-settings

# Tuning — defaults below are sized for Render's base 512MB worker tier.
# A fixed TILE_DEG can never be "safe everywhere" on its own (a 2-degree
# box over open ocean vs. over Lagos or Manhattan are wildly different
# workloads), so any region that still runs out of memory at this size
# gets automatically quartered and retried down to MIN_SPLIT_DEG — that's
# the real fix for OOMs, these knobs are just the starting point.
# If you're on a bigger Render plan, raise DUCKDB_MEMORY_LIMIT /
# DUCKDB_THREADS / TILE_DEG for faster full-world passes.
TILE_DEG=2
MIN_SPLIT_DEG=0.1
MAX_SPLIT_DEPTH=8
DUCKDB_THREADS=1
DUCKDB_MEMORY_LIMIT=300MB
MIN_CONFIDENCE=0.0
SCAN_IDLE_SLEEP_SECONDS=21600
INGEST_BATCH_SIZE=500
