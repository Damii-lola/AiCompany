# Copy these into wherever this worker actually runs (GitHub Actions
# repo secrets, a Render worker's Environment, or a VM's .env).

# Prisma Postgres connection string(s). One free Prisma database caps out
# (2GB storage / 200k ops a month) before a full US+territories backfill
# finishes, so this worker shards across as many free databases as you
# give it: set DATABASE_URL_1, DATABASE_URL_2, DATABASE_URL_3, ... (any
# count — add more any time BEFORE you start a pass, see scan_worker.py's
# module docstring for why the count has to stay fixed mid-pass) and it
# splits the full tile list evenly across them, scanning all of them AT
# THE SAME TIME. Apply database/schema.sql to EVERY shard database by
# hand before wiring up its secret — same one-time manual step as a
# single-database setup, just repeated once per shard.
#
# The DIRECT string (db.prisma.io, not pooled.db.prisma.io) is the safer
# default for each: this worker holds one connection open per shard for
# the whole run (up to ~5.5h on GitHub Actions) doing batched writes,
# which is exactly the long-lived-connection pattern the pooler isn't
# optimized for. Must include sslmode=require.
DATABASE_URL_1=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
# DATABASE_URL_2=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
# DATABASE_URL_3=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require

# Only have one database? A bare DATABASE_URL (no numeric suffix) still
# works as a single implicit shard — you don't need the _1 at all for a
# one-database setup:
# DATABASE_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require

# Tuning — defaults below are sized for Render's base 512MB worker tier.
# A fixed TILE_DEG can never be "safe everywhere" on its own (a 2-degree
# box over open ocean vs. over a dense US metro are wildly different
# workloads), so any region that still runs out of memory at this size
# gets automatically quartered and retried down to MIN_SPLIT_DEG — that's
# the real fix for OOMs, these knobs are just the starting point.
# If you're on GitHub Actions (7GB+ runners) or a bigger plan, raise
# DUCKDB_MEMORY_LIMIT / DUCKDB_THREADS / TILE_DEG for faster passes.
# IMPORTANT: shards now run concurrently (one thread per shard), so
# DUCKDB_MEMORY_LIMIT is PER SHARD and total usage is roughly
# (number of shards) x this value — lower it if you're running a lot of
# shards at once on a memory-capped host.
TILE_DEG=2
MIN_SPLIT_DEG=0.1
MAX_SPLIT_DEPTH=8
DUCKDB_THREADS=1
DUCKDB_MEMORY_LIMIT=300MB
MIN_CONFIDENCE=0.0
SCAN_IDLE_SLEEP_SECONDS=21600
INGEST_BATCH_SIZE=500

# Only set this on a bounded host (GitHub Actions) — unset on Render/a VM
# where the worker should just run forever.
# MAX_RUNTIME_SECONDS=19800
