# Copy these into Render -> this worker service -> Environment.

# Same Supabase project as render-service, same secret key — this worker
# is Render-side infra too, so it holding a Supabase key doesn't break the
# "only Render holds Supabase credentials" rule (Kaggle never gets one).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=the-secret-key-from-supabase-api-settings

# Tuning — defaults are conservative for a modest Render worker plan.
# Raise DUCKDB_MEMORY_LIMIT / DUCKDB_THREADS if you're on a bigger plan
# and want faster passes; lower TILE_DEG further if you see OOM kills in
# the Render logs (smaller tiles = smaller per-query working set, at the
# cost of more tiles/more round trips).
TILE_DEG=10
DUCKDB_THREADS=2
DUCKDB_MEMORY_LIMIT=1536MB
MIN_CONFIDENCE=0.0
SCAN_IDLE_SLEEP_SECONDS=21600
INGEST_BATCH_SIZE=500
