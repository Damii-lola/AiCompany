# Copy these into wherever this worker actually runs (GitHub Actions
# repo secrets, a Render worker's Environment, or a VM's .env).

# Prisma Postgres connection string. The DIRECT string (db.prisma.io, not
# pooled.db.prisma.io) is the safer default here: this worker holds one
# connection open for the whole run (up to ~5.5h on GitHub Actions) doing
# batched writes, which is exactly the long-lived-connection pattern the
# pooler isn't optimized for. Must include sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require

# Tuning — defaults below are sized for Render's base 512MB worker tier.
# A fixed TILE_DEG can never be "safe everywhere" on its own (a 2-degree
# box over open ocean vs. over a dense US metro are wildly different
# workloads), so any region that still runs out of memory at this size
# gets automatically quartered and retried down to MIN_SPLIT_DEG — that's
# the real fix for OOMs, these knobs are just the starting point.
# If you're on GitHub Actions (7GB runners) or a bigger plan, raise
# DUCKDB_MEMORY_LIMIT / DUCKDB_THREADS / TILE_DEG for faster passes.
TILE_DEG=2
MIN_SPLIT_DEG=0.1
MAX_SPLIT_DEPTH=8
DUCKDB_THREADS=1
DUCKDB_MEMORY_LIMIT=300MB
MIN_CONFIDENCE=0.0
SCAN_IDLE_SLEEP_SECONDS=21600
INGEST_BATCH_SIZE=500

# Only set this on a bounded host (GitHub Actions) — unset on Render/a VM
# where the worker should just run forever.
# MAX_RUNTIME_SECONDS=19800
