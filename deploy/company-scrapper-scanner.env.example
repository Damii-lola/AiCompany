# On the VM: cp company-scrapper-scanner.env.example company-scrapper-scanner.env
# then edit the real .env with real values. The real .env file is
# git-ignored (see deploy/.gitignore) — it stays on the VM only, never
# committed, never pushed.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=the-secret-key-from-supabase-api-settings

# Tuning — the recursive tile-splitting in scan_worker.py means these are
# a starting point, not a hard ceiling: any region that's still too dense
# auto-quarters and retries regardless of these numbers. Raised from the
# Render-512MB defaults since this VM has real room (up to 24GB total,
# shared across however many workers you're running) — tune mem_limit in
# docker-compose.yml to match what you actually give this one.
TILE_DEG=5
MIN_SPLIT_DEG=0.1
MAX_SPLIT_DEPTH=8
DUCKDB_THREADS=2
DUCKDB_MEMORY_LIMIT=1536MB
MIN_CONFIDENCE=0.0
SCAN_IDLE_SLEEP_SECONDS=21600
INGEST_BATCH_SIZE=500
