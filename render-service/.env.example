# Copy these into Render -> your service -> Environment, not into a committed .env file.

# Prisma Postgres connection string — from the Prisma dashboard, Connect
# tab. Either the direct (db.prisma.io) or pooled (pooled.db.prisma.io)
# string works for this service; the pooled one is the normal pick for a
# web API fielding many short requests. Must include sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require

# Shared secret the Kaggle scanner sends in the x-ingest-secret header on
# every POST to /api/ingest/businesses. This is NOT issued by anything —
# you make it up yourself (any long random string). Put the EXACT SAME
# value here and in the Kaggle Secret named INGEST_SECRET. This is the
# only credential Kaggle ever holds for this whole system — it never gets
# a database credential.
INGEST_SECRET=generate-a-long-random-string

PORT=3000

# Live inference URL for OUR OWN fine-tuned chat-understanding worker
# (workers/researchers-company-scrapper-chat/, deployed via its
# modal_deploy.py — see that file for the one-time setup/deploy steps).
# Optional: leave unset and /api/chat keeps working via the deterministic
# regex parser alone (lib/chat.js) — the model is strictly additive, and
# /api/chat automatically falls back to the deterministic parser if this
# URL is unset, unreachable, slow, or returns something malformed, so it
# is always safe to deploy render-service before the worker model itself
# is trained/deployed.
MODEL_SERVER_URL=https://your-modal-username--company-scrapper-chat-understand.modal.run

