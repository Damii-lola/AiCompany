# Copy these into Render -> your service -> Environment, not into a committed .env file.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-secret-service_role-key      # SECRET key — this process writes with it
# SUPABASE_ANON_KEY is the "publishable" key — not required by this server
# (nothing here reads as an end user), keep it only if some other client needs it later.

# Mistral (used for /api/research — natural-language request parsing + category matching)
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# Shared secret the Kaggle scanner sends in the x-ingest-secret header on
# every POST to /api/ingest/businesses. Generate any long random string and
# put the SAME value in both this Render var and the Kaggle Secret
# INGEST_SECRET — never a Supabase key, since Kaggle must never hold one.
INGEST_SECRET=generate-a-long-random-string

PORT=3000
