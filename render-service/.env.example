# Copy these into Render -> your service -> Environment, not into a committed .env file.

# TiDB Cloud Starter connection string(s) — from TiDB Cloud's dashboard,
# "Connect" panel. Moved off Prisma Postgres entirely (see
# database/schema.mysql.sql's header for why and what changed). Set
# DATABASE_URL_1, DATABASE_URL_2, ... for a sharded setup (one per TiDB
# Cloud instance — keep these in sync with scanner-service's
# DATABASE_URL_N secrets, same numbering, same databases), or a bare
# DATABASE_URL for a single-instance setup. TiDB Cloud requires TLS,
# handled automatically unless the URL has a trailing ?ssl=false (only for
# a local, SSL-less MySQL/MariaDB test instance).
DATABASE_URL_1=mysql://USER:PASSWORD@HOST:4000/DBNAME

# Shared secret the Kaggle scanner sends in the x-ingest-secret header on
# every POST to /api/ingest/businesses. This is NOT issued by anything —
# you make it up yourself (any long random string). Put the EXACT SAME
# value here and in the Kaggle Secret named INGEST_SECRET. This is the
# only credential Kaggle ever holds for this whole system — it never gets
# a database credential.
INGEST_SECRET=generate-a-long-random-string

PORT=3000

